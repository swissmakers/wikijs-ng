# Normalize line endings of text files (LF in the repository)
*                 text=auto

# Shell scripts must keep LF, also in Windows checkouts
*.sh              text eol=lf
*.bash            text eol=lf

# Lock files: no textual diffs
*.lock            text -diff
package-lock.json text -diff

# SVG icons and logos are edited as text
*.svg             text

# Binary assets
*.png             binary
*.jpg             binary
*.jpeg            binary
*.gif             binary
*.ico             binary
*.webp            binary
*.pdf             binary
*.woff            binary
*.woff2           binary
*.ttf             binary
*.eot             binary
*.otf             binary
*.asar            binary
*.gz              binary
*.zip             binary

# Not part of source archives
.gitattributes    export-ignore
.gitignore        export-ignore
